# ── 机密：绝不提交 ──────────────────────────────
.env
# 简历等求职材料，含手机号与邮箱等个人信息
resume/

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# ── 运行时产物 ─────────────────────────────────
# 会话检查点数据库（多轮对话记忆存在这里）
*.db
*.sqlite
*.sqlite3
# 向量索引缓存
.chroma/
*.index

# ── 工具与编辑器 ────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.idea/
.vscode/
.DS_Store

# ── AI 工作区记录（含个人工作日志，不进仓库）────────
.workbuddy/

# ── 本地私有文档（不对外公开）──────────────────
# 需要公开某份文档时，用 git add -f docs/文件名 强制加入
docs/
