# ============================================================
# DocPilot 环境变量示例
# ------------------------------------------------------------
# 用法：把本文件复制成 .env，然后填入你自己的值
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# .env 已经在 .gitignore 里，不会被提交，可以放心写 Key。
# ============================================================

# ── 1. 选一个模型供应商 ──────────────────────────────────
# 可选值：deepseek | qwen | openai | ollama | mock
# mock = 离线模拟模型，不需要任何 Key，断网也能跑通全流程
DOCPILOT_PROVIDER=deepseek

# ── 2. 填对应的 API Key（只填你选的那一个就行）──────────────
# DeepSeek：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 通义千问（阿里云百炼）：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# OpenAI（如果你有）
OPENAI_API_KEY=

# ── 3. 模型与生成参数（一般不用改）──────────────────────────
# 留空则使用该供应商的默认模型，见 src/docpilot/config.py
DOCPILOT_MODEL=
DOCPILOT_TEMPERATURE=0

# ── 4. 检索方式 ─────────────────────────────────────────
# bm25   = 关键词检索（默认，零依赖、离线可跑）
# vector = 语义检索（需额外装 chromadb + sentence-transformers）
DOCPILOT_RETRIEVER=bm25

# ── 5. 图的行为参数（这几个值得调着玩，能加深理解）────────────
# 检索召回条数
DOCPILOT_TOP_K=4
# 证据评分的及格线（0~10 分），低于它触发"查询重写 → 重新检索"
DOCPILOT_SCORE_THRESHOLD=6.5
# 自纠正循环最多重写几次（防止无限循环，重要！）
DOCPILOT_MAX_REWRITES=2
